# --- الزامی در تولید ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
CREDENTIALS_ENCRYPTION_KEY=          # خروجی: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATABASE_URL=postgres://panel:password@panel-db:5432/panel   # دیتابیس خود پنل، نه سرور مشتریان
DJANGO_ALLOWED_HOSTS=postgis.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://postgis.ir

# --- پیامک sms.ir: فقط مقدار اولیه؛ بعداً از «تنظیمات سایت» در پنل مدیریت تغییر دهید ---
SMS_BACKEND=smsir
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=              # شناسه قالب «ارسال کد تأیید» در پنل sms.ir
SMSIR_CODE_PARAM=CODE           # نام متغیر قالب، مثلاً قالب: کد ورود شما: #CODE#
SMSIR_LINE_NUMBER=              # اختیاری: برای پیامک‌های هشدار حجم و انقضا
OTP_LENGTH=5
TRUSTED_PROXY_COUNT=1

# --- اختیاری ---
SITE_NAME=ژئوپایگاه
SITE_URL=https://postgis.ir
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=
TENANT_PREFIX=gp_
MAX_DATABASES_PER_USER=1
DJANGO_SUPERUSER_USERNAME=admin     # مدیر اولیه؛ فقط بار اول ساخته می‌شود
DJANGO_SUPERUSER_PASSWORD=          # بعد از اولین ورود از پنل عوض کنید
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@postgis.ir
DJANGO_DEBUG=0
