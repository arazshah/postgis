# --- الزامی در تولید ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
CREDENTIALS_ENCRYPTION_KEY=          # خروجی: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATABASE_URL=postgres://panel:password@panel-db:5432/panel   # دیتابیس خود پنل، نه سرور مشتریان
DJANGO_ALLOWED_HOSTS=postgis.araz.me
DJANGO_CSRF_TRUSTED_ORIGINS=https://postgis.araz.me

# --- اختیاری ---
SITE_NAME=ژئوپایگاه
SITE_URL=https://postgis.araz.me
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=
TENANT_PREFIX=gp_
MAX_DATABASES_PER_USER=1
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@araz.me
DJANGO_DEBUG=0
