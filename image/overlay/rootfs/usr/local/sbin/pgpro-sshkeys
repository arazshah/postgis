#!/usr/bin/env bash
# کلیدهای میزبان SSH (یکتا برای هر دستگاه) و کلید عمومی پشتیبان؛ پیش از ssh.service اجرا می‌شود.
set -euo pipefail
ssh-keygen -A >/dev/null 2>&1 || true
if id support >/dev/null 2>&1; then
  home=$(getent passwd support | cut -d: -f6)
  install -d -m 700 -o support -g support "$home/.ssh"
  # کلیدهای پشتیبان داخل ایمیج + کلیدهایی که مدیر بعداً در /etc/pgpro/support_keys.d/ می‌گذارد
  cat /etc/pgpro/support_keys /etc/pgpro/support_keys.d/* 2>/dev/null | grep -E '^(ssh-|ecdsa-|sk-)' > "$home/.ssh/authorized_keys.new" || true
  install -m 600 -o support -g support "$home/.ssh/authorized_keys.new" "$home/.ssh/authorized_keys"
  rm -f "$home/.ssh/authorized_keys.new"
fi
